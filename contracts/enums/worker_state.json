{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-marketing-os/contracts/enums/worker_state.json",
  "title": "WorkerState",
  "description": "All possible states a worker can be in. Transitions between states are strictly controlled by the WorkerStateMachine.",
  "type": "string",
  "enum": [
    "IDLE",
    "PLANNING",
    "DISCOVERING",
    "SEARCHING",
    "FETCHING",
    "READING",
    "ANALYZING",
    "RESEARCHING",
    "VERIFYING",
    "MATCHING",
    "COLLABORATING",
    "WAITING_APPROVAL",
    "WAITING_DEPENDENCY",
    "DRAFTING",
    "EXECUTING",
    "LEARNING",
    "BLOCKED",
    "RATE_LIMITED",
    "FAILED",
    "COMPLETED"
  ],
  "x-transitions": {
    "IDLE":               ["PLANNING", "DISCOVERING", "SEARCHING"],
    "PLANNING":           ["DISCOVERING", "SEARCHING", "IDLE"],
    "DISCOVERING":        ["SEARCHING", "FETCHING", "IDLE"],
    "SEARCHING":          ["FETCHING", "ANALYZING", "IDLE"],
    "FETCHING":           ["READING", "ANALYZING", "RATE_LIMITED", "BLOCKED", "FAILED"],
    "READING":            ["ANALYZING", "RESEARCHING", "IDLE"],
    "ANALYZING":          ["RESEARCHING", "VERIFYING", "MATCHING", "COLLABORATING", "IDLE"],
    "RESEARCHING":        ["VERIFYING", "ANALYZING", "IDLE"],
    "VERIFYING":          ["MATCHING", "ANALYZING", "IDLE"],
    "MATCHING":           ["COLLABORATING", "DRAFTING", "IDLE"],
    "COLLABORATING":      ["IDLE", "WAITING_DEPENDENCY"],
    "DRAFTING":           ["WAITING_APPROVAL", "EXECUTING", "IDLE"],
    "WAITING_APPROVAL":   ["EXECUTING", "IDLE"],
    "WAITING_DEPENDENCY": ["IDLE", "PLANNING"],
    "EXECUTING":          ["LEARNING", "IDLE", "FAILED"],
    "LEARNING":           ["IDLE"],
    "RATE_LIMITED":       ["FETCHING", "IDLE"],
    "BLOCKED":            ["IDLE"],
    "FAILED":             ["IDLE"],
    "COMPLETED":          []
  },
  "x-terminal-states": ["COMPLETED"],
  "x-3d-animation-map": {
    "IDLE":               "idle_workstation",
    "PLANNING":           "planning_hologram",
    "DISCOVERING":        "searching_source_panels",
    "SEARCHING":          "query_console",
    "FETCHING":           "browser_interaction",
    "READING":            "document_scan",
    "ANALYZING":          "holographic_graph",
    "RESEARCHING":        "multi_document_float",
    "VERIFYING":          "evidence_comparison",
    "MATCHING":           "product_align",
    "COLLABORATING":      "data_package_transfer",
    "WAITING_APPROVAL":   "approval_pending_light",
    "WAITING_DEPENDENCY": "blocked_indicator",
    "DRAFTING":           "writing_interface",
    "EXECUTING":          "action_console",
    "LEARNING":           "memory_transfer",
    "RATE_LIMITED":       "warning_amber",
    "BLOCKED":            "warning_red",
    "FAILED":             "error_state",
    "COMPLETED":          "success_state"
  }
}
