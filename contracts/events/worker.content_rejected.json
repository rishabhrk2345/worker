{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-marketing-os/contracts/events/worker.content_rejected.json",
  "title": "WorkerContentRejectedPayload",
  "type": "object",
  "required": ["url", "reason"],
  "additionalProperties": false,
  "properties": {
    "url":              { "type": "string" },
    "reason":           { "type": "string", "enum": ["irrelevant", "duplicate", "low_quality", "educational_only", "no_intent", "restricted_source", "off_topic", "already_processed"] },
    "relevance_score":  { "type": "number" },
    "explanation":      { "type": "string" }
  }
}
