# ==============================================================================
# AI Marketing Intelligence OS — Environment Configuration
# ==============================================================================

# Core System
APP_ENV=development
APP_NAME=ai-marketing-os
LOG_LEVEL=INFO
SIMULATION_MODE=true

# Organization / Tenant Context (Default seed organization)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
DEFAULT_ORG_NAME="Acme Growth Corp"

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aimarketing_os
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis 7 (Event bus & fast cache)
REDIS_URL=redis://localhost:6379/0

# Temporal (Durable Workflow Engine)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aimarketing-workforce-queue

# Security & Multi-Tenancy
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
CREDENTIAL_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS0xMjM0NTY= # 32-byte base64 key for AES-256-GCM

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
NEXTAUTH_SECRET=super-secret-nextauth-key-change-in-prod
NEXTAUTH_URL=http://localhost:3000

# LLM Providers (LiteLLM routing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LITELLM_CHEAP_MODEL=gpt-4o-mini
LITELLM_MEDIUM_MODEL=gpt-4o
LITELLM_STRONG_MODEL=claude-3-7-sonnet

# Embeddings & Vector Search
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Source Connector Credentials (encrypted before storing in DB)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_API_KEY=
NEWSAPI_KEY=

# Distributed Tracing & Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-marketing-os
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
